# SQLite via libsql. Local file by default; use a libsql:// Turso URL + token for a hosted deploy.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL (used for buyer links and the Payaza redirect_url)
APP_URL=http://localhost:3000

# Payaza (dashboard → Settings → Developers). Test-mode keys.
PAYAZA_PUBLIC_KEY=PZ78-PKTEST-...
PAYAZA_SECRET_KEY=
PAYAZA_MODE=Test

# Indicative FX used for the "estimate" KES figures (Payaza doesn't return a rate on collections)
FX_USD_KES=129.2
FX_EUR_KES=144.5
FX_GBP_KES=172.8

# Demo exporter created by `pnpm db:seed`
SEED_EXPORTER_EMAIL=demo@tracepay.test
SEED_EXPORTER_PASSWORD=avocado2026
